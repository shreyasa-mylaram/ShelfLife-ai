    "health_model": {
      "file": "health_model.joblib",
      "type": "RandomForestRegressor",
      "task": "regression",
      "r2_score": 0.9991,
      "features": ["temperature", "humidity", "vibration", "cooling_power", "days_in_transit"],
      "output": "health_score (0-100)"
    },
    "shelf_life_model": {
      "file": "shelf_life_model.joblib",
      "type": "RandomForestRegressor",
      "task": "regression",
      "r2_score": 0.8905,
      "scaler": "shelf_life_scaler.joblib",
      "features_file": "shelf_life_features.json",
      "output": "remaining_days (0-N)"
    },
    "forecast_model": {
      "file": "forecast_model.joblib",
      "type": "RandomForestRegressor",
